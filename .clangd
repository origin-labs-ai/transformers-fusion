CompileFlags:
  Compiler: clang-cl
  Add:
    - --target=x86_64-pc-windows-msvc
    - -std:c++20
    - /EHsc
    - -DQUANT_AVX2
    - -D__AVX2__
    - -DWIN32
    - -D_WIN32
    - -D_WINDOWS
    - -DNDEBUG
    - -DNOMINMAX
    - -DWIN32_LEAN_AND_MEAN
    - -D_CRT_SECURE_NO_WARNINGS
    - -DQUANT_USE_DIRECTX
    - -DQUANT_USE_VULKAN
    - -Iinclude
    - -Isrc
    - -Isrc/adapters/include
    - -Iengines/inference
    - -Iengines/quant
    - -Iengines/trainer/dense
    - -Iengines/trainer/moe
    - -Iengines/trainer/moe/vision
    - -Iengines/trainer/moe/audio
    - -Iengines/trainer/moe/embeddings
    - -Iengines/trainer/moe/image
    - -Iengines/trainer/moe/ocr
    - -Iengines/trainer/moe/text
    - -Iengines/trainer/moe/video
    - -Iengines/trainer/multimodal
    - -Iengines/trainer/multimodal/vision
    - -Iengines/trainer/multimodal/audio
    - -Iengines/trainer/multimodal/embeddings
    - -Iengines/trainer/multimodal/image
    - -Iengines/trainer/multimodal/ocr
    - -Iengines/trainer/multimodal/text
    - -Iengines/trainer/multimodal/video
    - -Iinferno
    - -Ibuild
  Remove:
    - -march=*
    - -mavx*
    - -mfma
    - -mbmi2
    - -msse*
    - -Werror
